# Copy this file to sync/.env and fill it in. sync/.env is git-ignored and stays on this
# computer: it is never uploaded to GitHub, Vercel or Supabase.

# The app account whose household receives the transactions (the same email and
# password you use to sign in to the budget app).
APP_EMAIL=
APP_PASSWORD=

# The bank and card details below are needed only for running from the command line
# (npm run sync). When you use the website's developer screen with the agent
# (npm run agent), fill them in there instead and leave these empty.

# Every bank and card in SOURCES (run-sync.mjs) can be filled in the same way: the name in
# capitals, an underscore, and the field, for example HAPOALIM_USERCODE, ISRACARD_CARD6DIGITS.
# Fill in only what you use.
# Discount: ID number, password, and the identification code ("num").
DISCOUNT_ID=
DISCOUNT_PASSWORD=
DISCOUNT_NUM=

# Mizrahi-Tefahot: username and password.
MIZRAHI_USERNAME=
MIZRAHI_PASSWORD=

# Max credit card: username and password of the Max website.
MAX_USERNAME=
MAX_PASSWORD=

# A second Max account with its own login (for example, the other partner's).
MAX2_USERNAME=
MAX2_PASSWORD=

# Cal (Visa Cal) credit card: username and password of the Cal website.
VISACAL_USERNAME=
VISACAL_PASSWORD=

# Your Claude API key, used to file imported charges under categories. Without it they are
# imported without a category. (When this folder sits inside the app's own folder, the key
# in the app's .env.local is used and this can stay empty.)
ANTHROPIC_API_KEY=

# Optional: path to Chrome when it is not installed in the usual place.
CHROME_PATH=

# Optional: set to off to read only expenses. By default money coming in is recorded as
# income, so fixed incomes should not also be defined in the app's settings.
IMPORT_INCOME=

# Optional: set to on to watch the browser while the agent signs in to the bank and the card.
# Useful when a login fails or the site asks for a code.
SHOW_BROWSER=

# Optional: set to off to stop the agent from running a sync by itself once a day.
AUTO_SYNC=
