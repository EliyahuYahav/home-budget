# Copy this file to sync/.env and fill it in. sync/.env is git-ignored and stays on this
# computer: it is never uploaded to GitHub, Vercel or Supabase.

# The app account whose household receives the transactions (the same email and
# password you use to sign in to the budget app).
APP_EMAIL=
APP_PASSWORD=

# The bank and card details below are needed only for running from the command line
# (npm run sync). When you use the website's developer screen with the agent
# (npm run agent), fill them in there instead and leave these empty.

# Fill in only the bank you use; leave the other one empty.
# Discount: ID number, password, and the identification code ("num").
DISCOUNT_ID=
DISCOUNT_PASSWORD=
DISCOUNT_NUM=

# Mizrahi-Tefahot: username and password.
MIZRAHI_USERNAME=
MIZRAHI_PASSWORD=

# Max credit card: username and password of the Max website.
MAX_USERNAME=
MAX_PASSWORD=

# Optional: path to Chrome when it is not installed in the usual place.
CHROME_PATH=

# Optional: set to off to stop the agent from running a sync by itself once a day.
AUTO_SYNC=
