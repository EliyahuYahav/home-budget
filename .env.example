# Copy this file to .env.local and fill in the values. .env.local is git-ignored.

# Supabase project (supabase.com -> your project -> Project Settings -> API).
# The URL looks like https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" / "publishable" key. It is safe in the browser: row level security
# in supabase/schema.sql is what protects the data. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API key (platform.claude.com -> API keys). Server-only.
# Optional: without it the chat uses a simple built-in parser instead of Claude.
ANTHROPIC_API_KEY=
