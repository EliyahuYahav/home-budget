# Copy this file to .env.local and fill in the values. .env.local is git-ignored.

# Supabase project (supabase.com -> your project -> Project Settings -> API).
# The URL looks like https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" / "publishable" key. It is safe in the browser: row level security
# in supabase/schema.sql is what protects the data. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API key (platform.claude.com -> API keys).
# The website does not use it: each household saves its own key in the settings, and without
# one its chat uses a simple built-in parser. It is read only by the bank sync on the home
# computer (sync/), to file imported charges under categories.
ANTHROPIC_API_KEY=

# The monthly report by email, sent through Brevo (brevo.com, free for 300 messages a day).
# The key can only send mail. REPORT_FROM_EMAIL is an address verified there as a sender.
# Server-only. Without them the report is simply not sent.
BREVO_API_KEY=
REPORT_FROM_EMAIL=

# Lets the server act with no member signed in, which only two routes do: the monthly report
# (src/app/api/cron) and the Telegram webhook (src/app/api/telegram). This key reads and
# writes everything, so it lives only in the server's environment: never in the browser,
# never with a NEXT_PUBLIC_ name, never in git. (Supabase -> Project Settings -> API keys.)
SUPABASE_SERVICE_ROLE_KEY=

# Vercel sends this with the scheduled call that sends the monthly reports, and the route
# refuses a call without it. Any long random string.
CRON_SECRET=

# The Telegram bot's token, from @BotFather. After setting it, press "חיבור הבוט לאתר" once
# in the developer screen. Without it the Telegram card in the settings stays off.
TELEGRAM_BOT_TOKEN=

# Where the site lives, for links in the report and for the bot. On Vercel it is known
# without this.
SITE_URL=

# Seals the Claude keys that households save in the settings. Any random string of 32
# characters or more; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Server-only. Changing it makes every saved key unreadable, and they must be saved again.
SECRETS_KEY=
